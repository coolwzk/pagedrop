# Copy to .env and fill in before docker compose up

PORT=3780
AUTH_ENABLED=true
# Self-service signup on login page (true/false)
AUTH_ALLOW_REGISTER=true
ADMIN_USERNAME=admin
# Leave empty for first-run default: admin / admin123 (shown on login page)
# ADMIN_PASSWORD=change-me-to-a-strong-password
SESSION_SECRET=replace-with-long-random-string
# PUBLIC_URL=http://192.168.1.10:3780
DEFAULT_TTL_DAYS=30
COOKIE_SECURE=false
